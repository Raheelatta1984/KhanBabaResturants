# ---------------------------------------------------------------------------
# Khan Baba platform — environment
# Copy to .env.local and fill in what you need.
#
# One variable is mandatory: DATABASE_URL (Supabase's Postgres connection
# string). Without it the app boots into a friendly "database not configured"
# screen and /api/health returns 503 — nothing else breaks, but nothing is
# stored either.
# ---------------------------------------------------------------------------

# ------------------------------- Database ----------------------------------
# Supabase → your project → Connect → "Connection pooling" → **Transaction**
# (port 6543). The host contains "pooler" and the username is
# "postgres.<project-ref>":
#
#   postgresql://postgres.phjsppfyhlgeznhiaqsc:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
#
# Use the pooler, not the direct db.<ref>.supabase.co host: the direct host is
# IPv6-only and is not reachable from Vercel functions. If the password contains
# @ : / ? # then URL-encode it (or reset the password in Supabase → Project
# Settings → Database).
#
# The schema is created and the demo data seeded automatically on the first
# request, so no migration command is needed in production. `npm run seed`
# (add `-- --reset` to wipe first) prepares a database ahead of time.
DATABASE_URL=

# Optional: cap the pool per server instance (default 1 on Vercel, 5 locally).
# DATABASE_POOL_MAX=1

# ------------------------------- Supabase ----------------------------------
# The same project. SUPABASE_URL and the secret key are what dish photos upload
# with; keep the secret key server-side only (it is a service-role-equivalent
# key and bypasses row-level security).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Created automatically on the first upload if it does not exist. Public bucket.
SUPABASE_STORAGE_BUCKET=menu-photos

# Public URL used for QR codes, Stripe redirects, sitemap and robots.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
PUBLIC_BASE_URL=http://localhost:3000

# Signs staff sessions and delivery quote tokens. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ------------------------------ Dish photos --------------------------------
# The driver is picked automatically: Supabase → Blob → Google Drive → local disk.
# Force one with MEDIA_DRIVER=supabase | blob | gdrive | local (or the
# `media_driver` setting in Admin → Settings, which wins over this variable).
# MEDIA_DRIVER=auto

# Optional alternatives to Supabase Storage
# Vercel Blob (one env var, global CDN)
BLOB_READ_WRITE_TOKEN=

# Google Drive (photos live in your own Drive folder)
# 1. Google Cloud project → enable the "Google Drive API".
# 2. Create a service account, add a JSON key, paste the whole JSON here
#    (or its base64) — the private key's newlines may be escaped.
# 3. In Google Drive, share your photos folder with the service account's
#    client_email as **Editor**, then copy the folder id from its URL.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ----------------------------- Uber Direct ---------------------------------
# https://developer.uber.com/docs/deliveries/guides/direct
# Leave blank to use the built-in sandbox courier model.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_WEBHOOK_SECRET=
UBER_STORE_ID=khan-baba-sydney
# Override only for testing:
# UBER_AUTH_URL=https://login.uber.com/oauth/v2/token
# UBER_API_URL=https://api.uber.com/v1

# --------------------------- DoorDash Drive --------------------------------
# https://developer.doordash.com/en-US/docs/drive/
# Second delivery partner. Quote requests are signed with a short-lived JWT;
# webhook signatures are verified with the signing secret. Leave blank to
# exclude DoorDash from the auto quote comparison.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
DOORDASH_STORE_ID=khan-baba-sydney
DOORDASH_WEBHOOK_SECRET=
# DOORDASH_API_URL=https://openapi.doordash.com

# ------------------------------- Payments ----------------------------------
# Stripe Checkout hosts Visa, Mastercard, Amex and Afterpay/Clearpay. Card data
# never touches this app. Leave blank to run the labelled sandbox gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal Orders v2 (separate hosted wallet flow). PAYPAL_WEBHOOK_ID is used to
# verify CHECKOUT.ORDER.APPROVED / PAYMENT.CAPTURE.COMPLETED notifications.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=

# --------------------------- Square POS bridge ------------------------------
# DETACHED: the order lifecycle never calls Square. This bridge shares and
# synchronises transaction/POS data only. Without credentials it uses a local
# sandbox mirror; with credentials it can push completed orders, import POS
# payments and map item variants to the Square Catalog.
# Run a sync from Admin → Integrations, or schedule GET /api/ops/square/cron
# with "Authorization: Bearer $SQUARE_SYNC_SECRET". CRON_SECRET is a fallback.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_SYNC_SECRET=
CRON_SECRET=

# --------------------- Facebook Page (community meals) ----------------------
# A returned, untouched order can be posted to the Page. The first comment
# containing the claim keyword wins a free click & collect meal; the app replies
# "thank you we have got it booked", closes/hides later comments and issues a
# zero-cost pickup ticket. Without credentials the post is mirrored locally.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_API_VERSION=v19.0
# Webhook: GET/POST /api/webhooks/facebook (feed field "feed").

# --------------------------------- Node ------------------------------------
NODE_ENV=development
