# ---------------------------------------------------------------------------
# Khan Baba platform — environment
# Copy to .env.local and fill in what you need.
#
# One variable is mandatory: DATABASE_URL (a Neon Postgres connection string).
# Without it the app boots into a friendly "database not configured" screen and
# /api/health returns 503 — nothing else breaks, but nothing is stored either.
# ---------------------------------------------------------------------------

# ------------------------------- Database ----------------------------------
# Neon → your project → Connect → "Pooled connection" (host contains
# "-pooler"). The app talks to Postgres over HTTPS, so no TCP pool is held open.
#
#   postgresql://user:password@ep-xxx-pooler.ap-southeast-2.aws.neon.tech/khanbaba?sslmode=require
#
# The schema is created and the demo data seeded automatically on the first
# request, so no migration command is needed in production. For a direct
# (non-pooled) connection use the host without "-pooler" — handy for `npm run seed`.
DATABASE_URL=

# Public URL used for QR codes, Stripe redirects, sitemap and robots.
# On Vercel this is inferred from VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL.
PUBLIC_BASE_URL=http://localhost:3000

# Signs staff sessions and delivery quote tokens. Change in production.
SESSION_SECRET=change-me-to-a-long-random-string

# ------------------------------ Dish photos --------------------------------
# The driver is picked automatically: Blob → Google Drive → local disk.
# Force one with MEDIA_DRIVER=blob | gdrive | local (or the `media_driver`
# setting in Admin → Settings, which wins over this variable).
# MEDIA_DRIVER=auto

# Option A — Vercel Blob (simplest on Vercel: one env var, global CDN)
BLOB_READ_WRITE_TOKEN=

# Option B — Google Drive (photos live in your own Drive folder)
# 1. Google Cloud project → enable the "Google Drive API".
# 2. Create a service account, add a JSON key, paste the whole JSON here
#    (or its base64) — the private key's newlines may be escaped.
# 3. In Google Drive, share your photos folder with the service account's
#    client_email as **Editor**, then copy the folder id from its URL.
# Photos are made world-readable ("anyone with the link") and served from
# googleapis.com, so no Drive login is needed to view the menu.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# ----------------------------- Uber Direct ---------------------------------
# https://developer.uber.com/docs/deliveries/guides/direct
# Leave blank to use the built-in sandbox courier model.
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=
UBER_DIRECT_CUSTOMER_ID=
UBER_WEBHOOK_SECRET=
UBER_STORE_ID=khan-baba-sydney
# Override only for testing:
# UBER_AUTH_URL=https://login.uber.com/oauth/v2/token
# UBER_API_URL=https://api.uber.com/v1

# ------------------------------- Payments ----------------------------------
# Use Stripe Checkout (hosted, card data never touches this app).
# Leave blank to run the sandbox payment gateway.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------- Node ------------------------------------
NODE_ENV=development
